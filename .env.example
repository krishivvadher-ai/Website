# Server-only secrets. Copy to .env.local — NEVER commit real values, and
# NEVER use a NEXT_PUBLIC_ prefix for any key: that would ship it to the
# browser. All model calls happen in server routes (/api/chat,
# /api/organiser/*); the frontend bundle contains no keys.
#
# In production, keep keys in a secrets manager, rotate them, and enable
# secret scanning on the repository.

# Anthropic API key for the support assistant and organiser tools.
# Optional: without it, both fall back to grounded canned answers.
ANTHROPIC_API_KEY=

# Optional model override for chat/assist routes.
CHAT_MODEL=
